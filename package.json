{
  "name": "repo-to-codex",
  "version": "0.1.0",
  "description": "Turn any repository into a Codex-ready repository in one command.",
  "type": "module",
  "packageManager": "npm@10.8.2",
  "bin": {
    "repo-to-codex": "dist/src/cli/index.js"
  },
  "files": [
    "dist/src",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "test": "npm run build && node --test dist/test/*.test.js",
    "release:check": "npm run lint && npm run typecheck && npm test && npm pack --dry-run",
    "prepublishOnly": "npm run release:check"
  },
  "keywords": [
    "codex",
    "ai",
    "coding-agent",
    "agents-md",
    "cli",
    "repository-analysis"
  ],
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@types/node": "^22.18.1",
    "eslint": "^9.35.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.42.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ririri-rgb/repo-to-codex.git"
  },
  "bugs": {
    "url": "https://github.com/ririri-rgb/repo-to-codex/issues"
  },
  "homepage": "https://github.com/ririri-rgb/repo-to-codex#readme"
}
